# --- Central audit logging (optional; prerequisites in README "Central Audit
#     Logging" section) ---
# enable_central_logging   = true
# audit_log_bucket_name    = "my-org-audit-logs"   # without the -APPID suffix
# log_archive_appid        = "1300xxxxxx"
# log_archive_account_key  = "logging"             # core_accounts key of the log archive account
# log_archive_role_name    = "LandingZoneLogArchiveAccess"
# audit_log_retention_days = 365                   # 0 = keep forever
