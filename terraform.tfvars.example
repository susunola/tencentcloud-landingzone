# =============================================================================
# Tencent Cloud credentials
# In production, inject credentials via environment variables instead of
# committing secrets to git:
#   export TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxx
#   export TENCENTCLOUD_SECRET_KEY=xxxxxxxx
# To configure them explicitly in tfvars, uncomment the two lines below
# =============================================================================
# tencentcloud_secret_id  = "AKIDxxxxxxxxxxxxxxxxxxxxxxxx"
# tencentcloud_secret_key = "xxxxxxxxxxxxxxxxxxxxxxxx"

region = "ap-guangzhou"

root_node_name = "Root"

# --- Feature flags (trim: set to false to skip the whole module) ---
# enable_guardrails       = true   # Guardrails (SCP)
# enable_baselines        = true   # Account factory baselines
# enable_login_permission = true   # Management account login to business accounts
# enable_auditor_policy   = true   # Organization-wide read-only audit binding

# --- Business accounts (unique keys; department must be a departments key,
#     sub-departments included) ---
business_accounts = {
  "app-prod" = {
    name       = "AppA-Production"
    remark     = "Production business account"
    department = "business"
  }
  "dev-test" = {
    name       = "DevTest"
    remark     = "Sandbox test account"
    department = "sandbox"
  }
}

# --- Nested departments example (optional; parent points to another
#     department key, up to 3 levels: root -> L1 -> L2 -> L3) ---
# departments = [
#   { key = "core",     name = "Core",     remark = "Hosts security, logging and finance core accounts" },
#   { key = "business", name = "Business", remark = "All business accounts" },
#   { key = "prod",     name = "Prod",     remark = "Production",  parent = "business" },
#   { key = "proj-x",   name = "ProjectX", remark = "Key project", parent = "prod" },
#   { key = "sandbox",  name = "Sandbox",  remark = "Test and experiment accounts" },
# ]

# --- Finance (for delegated payment, add 7 to permission_ids and set pay_uin) ---
# member_permission_ids = [1, 2, 4]
# pay_uin               = "10000xxxxxx"

